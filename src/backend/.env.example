AWS_REGION=ap-south-1
AWS_PROFILE=cloudpassport
AWS_USE_LIVE=true
AWS_RESOURCE_CACHE_MS=60000

# Configure credentials locally with AWS CLI/SSO or the standard AWS credential chain.
# Never commit credentials or put access keys in frontend code.
# Cost Explorer requires ce:GetCostAndUsage. It returns billing data, not carbon emissions.
# Live passport resources are read from EC2, RDS, Lambda, S3, and CloudWatch CPU/activity metrics.
